{
  "name": "meetingmate-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "JW Meeting Assistant Monorepo (React Native Expo Frontend & Python FastAPI Backend)",
  "scripts": {
    "frontend": "npm run start --prefix frontend",
    "frontend:start": "npm run start --prefix frontend",
    "frontend:android": "npm run android --prefix frontend",
    "frontend:ios": "npm run ios --prefix frontend",
    "frontend:web": "npm run web --prefix frontend",
    "frontend:lint": "npm run lint --prefix frontend",
    "frontend:typecheck": "npm run typecheck --prefix frontend",
    "frontend:test": "node frontend/scripts/test-api-client.mjs",
    "backend:dev": "python -m uvicorn app.main:app --app-dir backend --reload --port 8000",
    "backend:test": "pytest backend/tests",
    "lint": "npm run lint --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend",
    "test": "npm run frontend:test && pytest backend/tests"
  }
}
