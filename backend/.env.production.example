# ==============================================================================
# JW Meeting Assistant Backend - Production Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' on your production host (e.g. Linux server on Tailscale).
# NEVER commit your real production .env with secret keys to version control.

# Application Metadata & Security Mode
APP_NAME="JW Meeting Assistant API"
APP_ENV=production
APP_DEBUG=false
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Server Network Binding
# Recommendation: Bind to 0.0.0.0 if running on a Tailscale-only machine,
# or bind strictly to your Tailscale IP (e.g. 100.x.y.z) to guarantee no public access.
HOST=0.0.0.0
PORT=8000

# CORS Configuration
# In production, DO NOT use wildcard (*). Restrict to your private family domains,
# Tailscale mesh IPs, and React Native Expo development origins:
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://100.64.0.0/10,exp://*

# Primary Database (SQLite)
# Stored persistently in data/ directory with WAL mode enabled
DATABASE_URL=sqlite:///./data/app.db
SQLITE_WAL_MODE=true
SQLITE_BUSY_TIMEOUT_MS=5000

# Embedded Vector Database (ChromaDB)
# Local vector embeddings storage, telemetry disabled for private deployment
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_ANONYMIZED_TELEMETRY=false

# LLM Integration (Groq API)
# Get your production key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_production_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=30.0
GROQ_MAX_RETRIES=2
GROQ_TEMPERATURE=0.3

# Protection & Rate Limiting
# Protect Groq API quota from accidental loops or excessive family queries
MAX_UPLOAD_SIZE_MB=15
MAX_REQUEST_BODY_SIZE_MB=2
RATE_LIMIT_PER_MINUTE=60

# Optional Family Authorization Key
# When enabled (true), requests must include the header 'X-Family-Token' or 'X-API-Key'
ENABLE_FAMILY_KEY_CHECK=false
FAMILY_API_KEY=change_this_to_a_secure_family_passphrase

# Structured Logging
# Options: INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
